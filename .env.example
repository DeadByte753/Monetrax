# Copy to .env (never commit .env). All values are optional for local development.

# Signs session cookies. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# If unset, Monetrax creates instance/secret_key on first run.
SECRET_KEY=

# PostgreSQL in production; leave empty to use instance/monetrax.sqlite3.
DATABASE_URL=

# true when the site is served over HTTPS (also turns on HSTS).
SECURE_COOKIES=false

# Number of reverse proxies in front of the app (Render: 1). 0 when reached directly.
TRUST_PROXY=0

APP_TIMEZONE=Asia/Manila
MONETRAX_REQUIRE_SCHOOL_EMAIL=true
