# Copy to .env (never commit .env) or set these in your shell / Render dashboard.
SECRET_KEY=change-me-to-a-long-random-string
# Leave unset locally to use SQLite at instance/monetrax.sqlite3
# DATABASE_URL=postgresql://user:password@host:5432/monetrax
APP_TIMEZONE=Asia/Manila
MONETRAX_REQUIRE_SCHOOL_EMAIL=true
SECURE_COOKIES=false
